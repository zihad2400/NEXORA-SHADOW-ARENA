# Local dev DB
MONGODB_URI=mongodb://127.0.0.1:27017/nexora_dev

# 32+ chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-32-plus-random-chars

APP_URL=http://localhost:3000

# Optional: first registration with this email becomes admin.
# Leave unset in production. Prefer scripts/promote-admin.mjs.
# ADMIN_EMAIL=

RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MS=60000
